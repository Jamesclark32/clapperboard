{
    "name": "jamesclark32/clapperboard",
    "version": "0.1.3",
    "description": "Opinionated Laravel application code generation commands for AI agents.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "illuminate/console": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/support": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/view": "^10.0|^11.0|^12.0|^13.0"
    },
    "autoload": {
        "psr-4": {
            "JamesClark32\\Clapperboard\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "JamesClark32\\Clapperboard\\CodegenServiceProvider"
            ]
        }
    }
}
